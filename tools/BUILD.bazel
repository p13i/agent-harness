load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "bundle_lib",
    srcs = ["bundle.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "install_lib",
    srcs = ["install.py"],
    visibility = ["//visibility:public"],
    deps = [":bundle_lib"],
)

py_library(
    name = "coverage_gate_lib",
    srcs = ["coverage_gate.py"],
)

py_binary(
    name = "install",
    srcs = [
        "bundle.py",
        "install.py",
    ],
    main = "install.py",
    deps = ["//agent_harness"],
)

py_binary(
    name = "bundle",
    srcs = ["bundle.py"],
    main = "bundle.py",
)

py_test(
    name = "ui_gallery_test",
    srcs = ["ui_gallery_test.py"],
    main = "ui_gallery_test.py",
    deps = [
        "//agent_harness",
        "@agent_harness_pip//pytest",
    ],
)

py_test(
    name = "wsl_e2e_test",
    srcs = ["wsl_e2e_test.py"],
    main = "wsl_e2e_test.py",
    deps = [
        "//agent_harness",
        "@agent_harness_pip//pytest",
    ],
)

py_test(
    name = "coverage_gate_test",
    srcs = ["coverage_gate_test.py"],
    main = "coverage_gate_test.py",
    deps = [
        ":coverage_gate_lib",
        "@agent_harness_pip//pytest",
    ],
)

py_binary(
    name = "coverage_gate",
    srcs = ["coverage_gate.py"],
    main = "coverage_gate.py",
)

py_binary(
    name = "live_smoke",
    srcs = ["live_smoke.gpt.py"],
    data = ["//cmd:agent-harness"],
    main = "live_smoke.gpt.py",
    deps = ["//agent_harness"],
)

py_test(
    name = "live_smoke_test",
    srcs = ["live_smoke_test.gpt.py"],
    data = [
        ":live_smoke",
        "live_smoke.gpt.py",
    ],
    main = "live_smoke_test.gpt.py",
    deps = [
        "//agent_harness",
        "@agent_harness_pip//pytest",
    ],
)

py_test(
    name = "install_test",
    srcs = [
        "bundle.py",
        "install.py",
        "install_test.py",
    ],
    main = "install_test.py",
    deps = [
        "//agent_harness",
        "@agent_harness_pip//pytest",
    ],
)
