{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p13i/agent-harness/event/v1",
  "type": "object",
  "required": [
    "session_id",
    "sequence",
    "event_id",
    "event_type",
    "created_at"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
