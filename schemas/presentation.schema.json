{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p13i/agent-harness/presentation/v1",
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id",
        "attempt_id",
        "provider",
        "model",
        "effort",
        "status",
        "started_at",
        "ended_at"
      ],
      "properties": {
        "turn_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "ended_at": {
          "type": "string"
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id",
        "turn_ids",
        "command_id",
        "turn_ref",
        "request",
        "status",
        "started_at",
        "completed_at",
        "first_sequence",
        "last_sequence",
        "attempts",
        "result",
        "safety",
        "checkpoint_id",
        "evidence",
        "reconciliation",
        "activity"
      ],
      "properties": {
        "turn_id": {
          "type": "string"
        },
        "turn_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command_id": {
          "type": "string"
        },
        "turn_ref": {
          "type": "object"
        },
        "request": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        },
        "first_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "result": {
          "type": "object"
        },
        "safety": {
          "type": "object"
        },
        "checkpoint_id": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reconciliation": {
          "type": "object"
        },
        "activity": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "turn_page": {
      "type": "object",
      "required": [
        "schema",
        "session_id",
        "revision",
        "after_sequence",
        "next_after_sequence",
        "turns",
        "session_activity"
      ],
      "properties": {
        "schema": {
          "const": "p13i/agent-harness/presentation/v1"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "after_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "next_after_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/turn"
          }
        },
        "session_activity": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "turn_detail": {
      "type": "object",
      "required": [
        "schema",
        "session_id",
        "revision",
        "turn"
      ],
      "properties": {
        "schema": {
          "const": "p13i/agent-harness/presentation/v1"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "turn": {
          "$ref": "#/$defs/turn"
        }
      }
    },
    "checkpoint_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "checkpoint_id",
        "session_id",
        "language",
        "start_line",
        "next_start_line",
        "total_lines",
        "truncated",
        "redactions",
        "binary",
        "changed_files",
        "content"
      ],
      "properties": {
        "schema": {
          "const": "p13i/agent-harness/presentation/v1"
        },
        "checkpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "language": {
          "const": "diff"
        },
        "start_line": {
          "type": "integer",
          "minimum": 0
        },
        "next_start_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_lines": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "redactions": {
          "type": "integer",
          "minimum": 0
        },
        "binary": {
          "type": "boolean"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/turn_page"
    },
    {
      "$ref": "#/$defs/turn_detail"
    },
    {
      "$ref": "#/$defs/checkpoint_diff"
    }
  ]
}
